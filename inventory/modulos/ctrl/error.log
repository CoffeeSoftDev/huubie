[ UNIX_USR ] :: nt authority\system
[ WINDOWS_USR ] :: DESKTOP-FHJB2CN$
[ INFO ] ::  
            SELECT DISTINCT m.id, m.name, m.code, m.icon, m.description, m.route, m.orden
            FROM fayxzvov_erp.modules m
            JOIN fayxzvov_erp.sections s       ON s.module_id  = m.id AND s.is_active = 1
            JOIN fayxzvov_erp.permissions p    ON p.section_id = s.id AND p.is_active = 1
            JOIN fayxzvov_erp.users_braches ub ON ub.role_id   = p.role_id
            WHERE m.is_active = 1 AND ub.user_id = ? AND ub.branch_id = ?
            ORDER BY m.orden ASC, m.id ASC
        
