#RewriteEngine On

# Redireccionar a la versión sin "www."
#RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
#RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [R=301,L]

# Forzar el uso de SSL
#RewriteCond %{HTTPS} !=on
#RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# SESION DE 8 HORAS: se configura en conf/_Session.php, no aqui. Un php_value
# solo aplica con PHP como modulo de Apache y no separaba la carpeta de sesiones.

Options +FollowSymLinks
RewriteEngine on
# Sin RewriteBase: Apache toma la carpeta de este .htaccess como base, así la
# regla vale igual servido en /inventory/ que en /huubie/inventory/. Con el
# /inventory/ escrito a mano, "salir" daba 404 en local.
RewriteRule ^/$ index.php [L]
RewriteRule ^salir$ acceso/ctrl/ctrl-logout.php [L]


#COSTSYS