; ImageLab - configuracion. Copia este archivo como .env y ajusta lo que uses.
; El .env real no se versiona.
;
; OJO: los comentarios van con ; o con # y NO admiten parentesis: parse_ini_file truena.

; auto = gana el primer candidato disponible de cada alias.
; Tambien acepta: local, fal, venice, replicate, pollinations - para forzar uno.
IL_PROVIDER="auto"
IL_TIMEOUT=180

; En 1 el front ve provider y modelo reales. En 0 solo ve el alias, como TapEdit.
IL_REVEAL_ENGINE=1

; En 0 solo atiende peticiones desde esta maquina. Cambialo solo si sabes por que.
IL_ALLOW_REMOTE=0

; Certificados para las llamadas HTTPS. Si se deja vacio busca c:/wamp64/credentials/cacert.pem
IL_CA_BUNDLE=""

; ── Servidor local de difusion ─────────────────────────────────────────────
; La misma URL sirve para tu PC o para una GPU rentada por horas con el puerto
; reenviado: el driver es el mismo, solo cambia la direccion.
;   ComfyUI  -> http://127.0.0.1:8188   IL_LOCAL_KIND="comfyui"
;   A1111    -> http://127.0.0.1:7860   IL_LOCAL_KIND="a1111"
; Vacio = sin servidor local.
IL_LOCAL_BASE_URL=""
IL_LOCAL_KIND="comfyui"

; Vacio = usa el primer checkpoint instalado. Ejemplo: "sd_xl_turbo_1.0_fp16.safetensors"
IL_LOCAL_CHECKPOINT=""
IL_LOCAL_STEPS=20
IL_LOCAL_CFG=7.0
IL_LOCAL_SAMPLER="euler"
IL_LOCAL_SCHEDULER="normal"
; Cuanto se aleja del original al editar: 0.3 retoca, 0.8 reinventa.
IL_LOCAL_DENOISE=0.65
IL_LOCAL_NEGATIVE="lowres, blurry, watermark, text"

; ── Proveedores de nube ────────────────────────────────────────────────────
; fal.ai - key en https://fal.ai/dashboard/keys
FAL_API_KEY=""
FAL_BASE_URL="https://queue.fal.run"

; Venice - key en https://venice.ai/settings/api . Genera Y edita, y sus dos rutas
; son sincronas: la imagen vuelve en la misma respuesta.
VENICE_API_KEY=""
VENICE_BASE_URL="https://api.venice.ai/api/v1"
; En 0 Venice deja de desenfocar contenido adulto por su cuenta.
IL_VENICE_SAFE_MODE=1

; Replicate - token en https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=""
REPLICATE_BASE_URL="https://api.replicate.com/v1"
