# Configuracion local de Claude Code (contiene secretos como API keys)
.claude/settings.local.json
.claude/settings.json

# Base de datos local de conversaciones del Visor (CoffeeIA) — runtime, no versionar
coffee/app/visor/data/*.sqlite
coffee/app/visor/data/*.sqlite-wal
coffee/app/visor/data/*.sqlite-shm

# Base de datos local de usuarios (login) — runtime, no versionar
coffee/app/data/*.sqlite
coffee/app/data/*.sqlite-wal
coffee/app/data/*.sqlite-shm

# Respaldos que dejan los sincronizadores y migraciones de coffee/app — pesan
# decenas de MB y son copias de datos de runtime, no codigo.
coffee/app/_sync_backup_*/
coffee/app/_import_backup_*/
coffee/app/visor/_migracion_backup_*/
coffee/app/visor/_todo_backups_*/

.vscode/settings.json

# Snapshots de Playwright MCP - runtime, no versionar
.playwright-mcp/

# ImageLab: credenciales, imagenes generadas y base de trabajos. Todo runtime.
imagelab/.env
imagelab/uploads/
imagelab/data/*.sqlite
imagelab/data/*.sqlite-wal
imagelab/data/*.sqlite-shm
