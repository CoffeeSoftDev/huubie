DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=fayxzvov_app

; Correo (core/helpers/_Message.php): el codigo de recuperar contraseña.
; Sin MAIL_HOST se usa mail() de PHP, que en local (WAMP) nunca entrega: no hay
; servidor de correo en localhost:25. 587 = STARTTLS, 465 = TLS directo.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Huubie
; Opcional: si PHP no trae certificados raiz y falla el TLS
MAIL_CA_BUNDLE=
