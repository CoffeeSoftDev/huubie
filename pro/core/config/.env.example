DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=fayxzvov_app

; Correo (core/helpers/_Message.php): el codigo de recuperar contraseña.
; Sin MAIL_HOST se usa mail() de PHP, que en local (WAMP) nunca entrega: no hay
; servidor de correo en localhost:25. 587 = STARTTLS, 465 = TLS directo.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Huubie
; Opcional: si PHP no trae certificados raiz y falla el TLS
MAIL_CA_BUNDLE=

; Stripe (core/billing/_Stripe.php): el cobro en linea de las suscripciones.
; sk_test_... en pruebas, sk_live_... en produccion. Nunca la publicable (pk_).
STRIPE_SECRET_KEY=
; El secreto del webhook api/ctrl/ctrl-stripe.php (whsec_...). Cada entorno tiene
; el suyo: el del panel de Stripe en produccion, el de "stripe listen" en local.
STRIPE_WEBHOOK_SECRET=
; Opcional: cacert.pem si PHP no trae certificados raiz (WAMP)
STRIPE_CA_BUNDLE=

; WhatsApp (core/helpers/_WhatsApp.php): avisos de pedido nuevo, cierre de turno
; y cierre del dia. Mismo envio que alpha. greenapi | ultramsg | simulado.
; Vacio = simulado: no sale nada a la red y el historial lo marca «simulado».
WHATSAPP_PROVEEDOR=
; Green API: idInstance y apiTokenInstance de console.green-api.com
GREENAPI_INSTANCIA=
GREENAPI_TOKEN=
; Opcional: el apiUrl de la instancia; vacio = https://api.green-api.com
GREENAPI_URL=
; UltraMsg: instanceXXXXX y su token
ULTRAMSG_INSTANCIA=
ULTRAMSG_TOKEN=

; Agente de WhatsApp (core/helpers/_WhatsAppMeta.php): Meta Cloud API, aparte de
; los avisos de arriba. El webhook es app/order/ctrl/ctrl-whatsapp-webhook.php.
; El secreto de la app (Configuracion de la app > Basica). Vacio = el webhook
; rechaza todo lo que llega.
WHATSAPP_META_APP_SECRET=
; La palabra que se escribe igual en el panel de Meta al registrar el webhook.
; Solo letras y numeros. Vacio = Meta no puede verificar el webhook.
WHATSAPP_META_VERIFY_TOKEN=
; El token para ENVIAR: usuario del sistema de Meta con whatsapp_business_messaging
; y whatsapp_business_management, caducidad «Nunca». Vacio = todo simulado (nada
; sale a la red). Se pone AL FINAL: con el, lo que se manda le llega al cliente.
WHATSAPP_META_TOKEN=
; Opcional: version de la Graph API. Vacio = v23.0
WHATSAPP_META_GRAPH_VERSION=
; Opcional: nombre e idioma de las plantillas aprobadas en Meta. Vacio = los de
; fabrica: huubie_saldo_pendiente, huubie_ya_abrimos, huubie_tarjeta_digital, es_MX
WHATSAPP_META_TPL_SALDO=
WHATSAPP_META_TPL_ABRIMOS=
WHATSAPP_META_TPL_TARJETA=
WHATSAPP_META_TPL_IDIOMA=
; La direccion publica de app/order, con https y sin / al final, por ejemplo
; https://midominio.com/pro/app/order. Arma los enlaces del portal y de la tienda;
; el cron no tiene dominio: sin esto no salen recordatorios.
WHATSAPP_PUBLIC_URL=

; Modelo del agente (core/helpers/_IaOllama.php): Ollama Cloud. Vacio = sin
; propuestas (salvo «hablar con una persona», que no usa modelo).
OLLAMA_API_KEY=
; Opcional: otro modelo. Vacio = gpt-oss:120b-cloud
WHATSAPP_AGENT_MODEL=
; Opcionales: servidor (vacio = https://ollama.com), espera en segundos y certificados
OLLAMA_BASE_URL=
OLLAMA_TIMEOUT=
OLLAMA_CA_BUNDLE=
