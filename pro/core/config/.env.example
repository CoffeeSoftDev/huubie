DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=fayxzvov_app

; Correo (core/helpers/_Message.php): el codigo de recuperar contraseña.
; Sin MAIL_HOST se usa mail() de PHP, que en local (WAMP) nunca entrega: no hay
; servidor de correo en localhost:25. 587 = STARTTLS, 465 = TLS directo.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Huubie
; Opcional: si PHP no trae certificados raiz y falla el TLS
MAIL_CA_BUNDLE=

; Stripe (core/billing/_Stripe.php): el cobro en linea de las suscripciones.
; sk_test_... en pruebas, sk_live_... en produccion. Nunca la publicable (pk_).
STRIPE_SECRET_KEY=
; El secreto del webhook api/ctrl/ctrl-stripe.php (whsec_...). Cada entorno tiene
; el suyo: el del panel de Stripe en produccion, el de "stripe listen" en local.
STRIPE_WEBHOOK_SECRET=
; Opcional: cacert.pem si PHP no trae certificados raiz (WAMP)
STRIPE_CA_BUNDLE=
